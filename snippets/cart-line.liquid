{%- comment -%} Params: item, index (1-based line), uid_prefix {%- endcomment -%}
{%- assign line_uid = uid_prefix | append: '-' | append: index -%}
<li class="line" data-line="{{ index }}">
  <a href="{{ item.url }}" class="line__media" tabindex="-1" aria-hidden="true">
    {% render 'product-media', product: item.product, variant: item.variant, uid: line_uid, sizes: '96px', class: 'line__art' %}
  </a>
  <div class="line__body">
    <a href="{{ item.url }}" class="line__title">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="line__meta">{{ item.variant.title | escape }}</p>
    {%- endunless -%}
    {%- if item.selling_plan_allocation -%}
      <p class="line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="line__discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
    {%- endfor -%}

    <div class="line__row">
      <div class="qty" data-qty>
        <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icon', icon: 'minus' %}</button>
        <span class="qty__value" aria-live="polite">{{ item.quantity }}</span>
        <button type="button" class="qty__btn" data-qty-change="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">{% render 'icon', icon: 'plus' %}</button>
      </div>
      <div class="line__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <s>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </div>
    <button type="button" class="line__remove text-link" data-qty-change="0">Remove</button>
  </div>
</li>
