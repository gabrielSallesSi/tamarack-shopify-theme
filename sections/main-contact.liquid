{%- comment -%}
  Contact page: page title and content, a contact form that sends to the store's email, and quick answers on the side.
{%- endcomment -%}
<section class="section contact" aria-labelledby="contact-{{ section.id }}">
  <div class="page-width contact__grid">
    <div class="contact__intro">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="contact-{{ section.id }}" class="page-title">{{ page.title | default: section.settings.heading | escape }}</h1>
      {%- if page.content != blank -%}
        <div class="rte contact__text">{{ page.content }}</div>
      {%- else -%}
        <div class="rte contact__text">{{ section.settings.text }}</div>
      {%- endif -%}
      <ul class="contact__facts" role="list">
        {%- for block in section.blocks -%}
          <li class="contact__fact" {{ block.shopify_attributes }}>
            <span class="contact__fact-label">{{ block.settings.label | escape }}</span>
            <span class="contact__fact-value">{{ block.settings.value | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="contact__card">
      {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">Thanks, your message is on its way. We reply within one business day.</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="form-message form-message--error" role="alert">Check the highlighted fields and try again.</p>
          {%- endif -%}
          <div class="contact__row">
            <div class="contact__field">
              <label for="ContactName-{{ section.id }}">Name</label>
              <input id="ContactName-{{ section.id }}" class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="contact__field">
              <label for="ContactEmail-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
              <input id="ContactEmail-{{ section.id }}" class="field" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
          </div>
          <div class="contact__field">
            <label for="ContactTopic-{{ section.id }}">Topic</label>
            <select id="ContactTopic-{{ section.id }}" class="field field--select" name="contact[topic]">
              <option>An order</option>
              <option>The flask</option>
              <option>Warranty</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="contact__field">
            <label for="ContactBody-{{ section.id }}">Message <span aria-hidden="true">*</span></label>
            <textarea id="ContactBody-{{ section.id }}" class="field field--area" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button button--primary contact__submit">Send message</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "class": "section-main-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading (when the page has no title)", "default": "Talk to a person" },
    { "type": "richtext", "id": "text", "label": "Text (when the page has no content)", "default": "<p>Questions about an order, a dent, or which color to pick? Send a note and a real person replies within one business day.</p>" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Quick fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Replies" },
        { "type": "text", "id": "value", "label": "Value", "default": "Within one business day" }
      ]
    }
  ],
  "presets": [{ "name": "Contact page" }]
}
{% endschema %}
