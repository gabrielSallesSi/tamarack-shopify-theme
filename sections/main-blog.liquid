{%- paginate blog.articles by 9 -%}
  <section class="section">
    <div class="page-width">
      <h1 class="page-title">{{ blog.title | escape }}</h1>
      <ul class="grid grid--articles" role="list">
        {%- for article in blog.articles -%}
          <li>
            <article class="article-card">
              {%- if article.image -%}
                <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
                </a>
              {%- endif -%}
              <h2 class="card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="card__meta">{{ article.published_at | time_tag: format: 'month_day_year' }}</p>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
            </article>
          </li>
        {%- else -%}
          <li class="empty-note">No stories yet.</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
