{%- comment -%}
  Color showcase: a 3D stack of cards, one per color, that cycles and can be flicked away.
  Card stack adapted from React Bits CardSwap (MIT + Commons Clause, David Haz).
{%- endcomment -%}
{%- liquid
  assign item = section.settings.product
  assign color_index = -1
  if item != blank
    for option in item.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'color' or option_name == 'colour'
        assign color_index = forloop.index0
        assign color_option = option
      endif
    endfor
  endif
-%}
<section class="section colors" aria-labelledby="colors-{{ section.id }}">
  <div class="page-width colors__grid">
    <div class="colors__copy">
      <h2 id="colors-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if color_index >= 0 -%}
        <ol class="colors__list" role="list" data-swap-list>
          {%- for value in color_option.values -%}
            {%- liquid
              assign value_variant = item.variants | where: 'option1', value | first
              if color_index == 1
                assign value_variant = item.variants | where: 'option2', value | first
              elsif color_index == 2
                assign value_variant = item.variants | where: 'option3', value | first
              endif
              capture hex
                render 'color-hex', name: value
              endcapture
              assign note_key = 'note_' | append: forloop.index
            -%}
            <li class="colors__row{% if forloop.first %} is-active{% endif %}" data-swap-row="{{ forloop.index0 }}">
              <button type="button" class="colors__name" data-swap-go="{{ forloop.index0 }}">
                <span class="colors__chip" style="--swatch: {{ hex }};"></span>
                {{ value | escape }}
              </button>
              <p class="colors__note">{{ section.settings[note_key] | escape }}</p>
              <a href="{{ value_variant.url }}" class="text-link colors__link">Shop {{ value | escape }}</a>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>

    {%- if color_index >= 0 -%}
      <div class="card-swap" data-card-swap tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ item.title | escape }} colors">
        <div class="card-swap-sizer" aria-hidden="true"><span></span></div>
        <div class="card-swap-stage">
          {%- for value in color_option.values -%}
            {%- liquid
              assign value_variant = item.variants | where: 'option1', value | first
              if color_index == 1
                assign value_variant = item.variants | where: 'option2', value | first
              elsif color_index == 2
                assign value_variant = item.variants | where: 'option3', value | first
              endif
              capture hex
                render 'color-hex', name: value
              endcapture
              assign swap_uid = 'swap-' | append: forloop.index
            -%}
            <div class="card-swap-slot" data-swap-index="{{ forloop.index0 }}" style="--swatch: {{ hex }};">
              <div class="card-swap-card colors__card">
                <span class="colors__card-name">{{ value | escape }}</span>
                <span class="colors__card-size">{{ item.metafields.custom.capacity | default: item.title }}</span>
                <div class="colors__card-photo">
                  {% render 'product-media', product: item, variant: value_variant, uid: swap_uid, sizes: '320px' %}
                </div>
                <span class="card-swap-card-rim" aria-hidden="true"></span>
              </div>
              <span class="card-swap-shade" aria-hidden="true"></span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- elsif request.design_mode -%}
      <p class="editor-note">Pick a product with a Color option to fill the card stack.</p>
    {%- endif -%}
  </div>
</section>

{%- if color_index >= 0 -%}
  <script src="{{ 'cardswap.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Color card stack",
  "class": "section-colors",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four colors, one flask" },
    { "type": "text", "id": "text", "label": "Text", "default": "Flick the front card away or pick a color. Same steel, same seal, different mood." },
    { "type": "text", "id": "note_1", "label": "Note for color 1", "default": "Pale as a snowfield. Hides scuffs better than you'd think." },
    { "type": "text", "id": "note_2", "label": "Note for color 2", "default": "Cold-water blue for glacier hikes and early swims." },
    { "type": "text", "id": "note_3", "label": "Note for color 3", "default": "Deep forest green that disappears in a pack." },
    { "type": "text", "id": "note_4", "label": "Note for color 4", "default": "Signal orange. Easy to find at the bottom of a tent." }
  ],
  "presets": [{ "name": "Color card stack" }]
}
{% endschema %}
