<section class="gate">
  <div class="gate__topo">{% render 'topo' %}</div>
  <div class="gate__inner">
    <p class="wordmark wordmark--light">
      {% render 'logo-mark' %}
      <span class="wordmark__text">{{ shop.name | escape }}</span>
    </p>
    <h1 class="gate__title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="gate__message">{{ shop.password_message | escape }}</p>
    {%- elsif section.settings.message != blank -%}
      <p class="gate__message">{{ section.settings.message | escape }}</p>
    {%- endif -%}
    {%- if section.settings.password_hint != blank -%}
      <p class="gate__hint">{{ section.settings.password_hint | escape }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'gate__form' -%}
      <label for="Password" class="gate__label">Store password</label>
      <div class="field-row">
        <input type="password" name="password" id="Password" class="field" autocomplete="current-password" required>
        <button type="submit" class="button button--primary">Enter store</button>
      </div>
      {%- if form.errors -%}
        <p class="form-message form-message--error" role="alert">That password didn't work. Check the message above and try again.</p>
      {%- endif -%}
    {%- endform -%}

    <p class="gate__fine">{{ section.settings.fine_print | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to Tamarack" },
    { "type": "textarea", "id": "message", "label": "Message", "info": "Shown when the store's own password message (Preferences) is empty.", "default": "A Shopify portfolio store designed and built by Gabriel Sá da Silveira. Enter the password to explore the full store." },
    { "type": "text", "id": "password_hint", "label": "Password hint", "info": "Leave empty to hide. Keep it in sync with the password in Preferences.", "default": "Password: tamarack" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Products are fictional and nothing ships." }
  ]
}
{% endschema %}
