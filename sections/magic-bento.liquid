{%- comment -%}
  Feature grid with cursor-following border glow, a shared spotlight, gentle tilt and click ripples.
  Adapted from React Bits MagicBento (MIT + Commons Clause, David Haz).
{%- endcomment -%}
{%- liquid
  assign item = section.settings.product
  assign feature_variant = blank
  if item != blank
    assign feature_variant = item.selected_or_first_available_variant
    for v in item.variants
      if v.options contains section.settings.product_color
        assign feature_variant = v
        break
      endif
    endfor
  endif
-%}
<section class="bento-section" aria-labelledby="bento-{{ section.id }}">
  <div class="page-width">
    <div class="bento-head">
      <h2 id="bento-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="bento" data-bento>
      <span class="bento__spotlight" aria-hidden="true"></span>

      <article class="bento__card bento__card--feature" style="--i: 0;">
        <div class="bento__feature-copy">
          <p class="bento__label">{{ section.settings.feature_label | escape }}</p>
          <h3 class="bento__title bento__title--big">{{ section.settings.feature_title | escape }}</h3>
          <p class="bento__text">{{ section.settings.feature_text | escape }}</p>
          {%- if item != blank -%}
            <a href="{{ feature_variant.url }}" class="text-link bento__link">Shop {{ item.title | escape }}</a>
          {%- endif -%}
        </div>
        <div class="bento__feature-photo">
          {%- if item != blank -%}
            {% render 'product-media', product: item, variant: feature_variant, uid: 'bento', sizes: '(min-width: 990px) 25vw, 60vw' %}
          {%- endif -%}
        </div>
      </article>

      <article class="bento__card bento__card--stat" style="--i: 1;">
        <p class="bento__label">Cold</p>
        <p class="bento__stat"><span data-count-to="{{ section.settings.cold_hours }}">{{ section.settings.cold_hours }}</span><small>h</small></p>
        <p class="bento__text">Ice water stays under {{ section.settings.cold_temp }}°C.</p>
      </article>

      <article class="bento__card bento__card--stat" style="--i: 2;">
        <p class="bento__label">Hot</p>
        <p class="bento__stat"><span data-count-to="{{ section.settings.hot_hours }}">{{ section.settings.hot_hours }}</span><small>h</small></p>
        <p class="bento__text">Coffee is still {{ section.settings.hot_temp }}°C.</p>
      </article>

      <article class="bento__card bento__card--photo" style="--i: 3;">
        <div class="bento__photo">
          {% render 'nature-photo', image: section.settings.photo, url: section.settings.photo_url, alt: '', class: 'bento__photo-img', sizes: '(min-width: 990px) 50vw, 100vw' %}
        </div>
        <div class="bento__photo-copy">
          <h3 class="bento__title">{{ section.settings.photo_title | escape }}</h3>
          <p class="bento__text">{{ section.settings.photo_text | escape }}</p>
        </div>
      </article>

      {%- for block in section.blocks -%}
        <article class="bento__card bento__card--small{% if forloop.last and forloop.length == 3 %} bento__card--wide{% endif %}" style="--i: {{ forloop.index | plus: 3 }};" {{ block.shopify_attributes }}>
          <p class="bento__label">{{ block.settings.label | escape }}</p>
          <h3 class="bento__title">{{ block.settings.title | escape }}</h3>
          <p class="bento__text">{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Magic bento",
  "class": "section-bento",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why one flask" },
    { "type": "text", "id": "text", "label": "Text", "default": "Everything that matters on a cold trail, nothing that doesn't." },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "text", "id": "product_color", "label": "Featured color", "default": "Spruce" },
    { "type": "text", "id": "feature_label", "label": "Feature label", "default": "The flask" },
    { "type": "text", "id": "feature_title", "label": "Feature title", "default": "One flask, made to outlast the trip" },
    { "type": "text", "id": "feature_text", "label": "Feature text", "default": "Two steel walls with nothing between them, a stopper that seals in a quarter turn and a handle you can grab with gloves on." },
    { "type": "number", "id": "cold_hours", "label": "Cold hours", "default": 24 },
    { "type": "number", "id": "cold_temp", "label": "Cold temperature (°C)", "default": 6 },
    { "type": "number", "id": "hot_hours", "label": "Hot hours", "default": 12 },
    { "type": "number", "id": "hot_temp", "label": "Hot temperature (°C)", "default": 62 },
    { "type": "image_picker", "id": "photo", "label": "Photo card image" },
    { "type": "text", "id": "photo_url", "label": "Photo card link", "default": "https://images.unsplash.com/photo-1695117399518-c17ab8239113" },
    { "type": "text", "id": "photo_title", "label": "Photo card title", "default": "Sealed in a quarter turn" },
    { "type": "text", "id": "photo_text", "label": "Photo card text", "default": "Throw it in the pack sideways. Nothing gets out." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Capacity" },
        { "type": "text", "id": "title", "label": "Title", "default": "1.2 L" },
        { "type": "text", "id": "text", "label": "Text", "default": "Enough for two on a long trail." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Magic bento",
      "blocks": [
        { "type": "card", "settings": { "label": "Capacity", "title": "1.2 L", "text": "Enough for two on a long trail." } },
        { "type": "card", "settings": { "label": "Cup lid", "title": "Pour into the cap", "text": "The steel cap unscrews into a 6 oz cup." } },
        { "type": "card", "settings": { "label": "Steel", "title": "18/8, double wall", "text": "Vacuum insulated, with a lifetime warranty on the seal." } }
      ]
    }
  ]
}
{% endschema %}
