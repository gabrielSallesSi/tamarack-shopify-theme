{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Announcement">
    <div class="page-width announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement__text shiny-text">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement__text shiny-text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Portfolio demo store. Products are fictional and nothing ships." },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
