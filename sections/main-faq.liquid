{%- comment -%}
  FAQ page: heading, a filter box, questions grouped by topic, and a help card that points to the contact page.
{%- endcomment -%}
{%- liquid
  assign contact_url = section.settings.contact_link | default: '/pages/contact'
-%}
<section class="faq-page" aria-labelledby="faq-page-{{ section.id }}" data-faq-page>
  <div class="page-width">
    <header class="faq-page__head">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="faq-page-{{ section.id }}" class="faq-page__title">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="faq-page__lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </header>

    <div class="faq-page__grid">
      <aside class="faq-page__side">
        <label class="faq-page__search">
          <span class="visually-hidden">Search questions</span>
          {% render 'icon', icon: 'search' %}
          <input type="search" class="faq-page__input" placeholder="Search questions" autocomplete="off" data-faq-filter>
        </label>
        <div class="faq-page__help">
          <p class="faq-page__help-title">{{ section.settings.help_title | escape }}</p>
          <p class="faq-page__help-text">{{ section.settings.help_text | escape }}</p>
          <a href="{{ contact_url }}" class="button button--primary faq-page__help-button">{{ section.settings.help_button | escape }}</a>
        </div>
      </aside>

      <div class="faq-page__list">
        {%- assign group = '' -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.topic != blank and block.settings.topic != group -%}
            {%- assign group = block.settings.topic -%}
            <p class="faq-page__topic" data-faq-topic>{{ group | escape }}</p>
          {%- endif -%}
          <details class="faq-item" data-faq-item {{ block.shopify_attributes }}>
            <summary class="faq-item__q">
              <span class="faq-item__text">{{ block.settings.question | escape }}</span>
              <span class="faq-item__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-item__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
        <p class="faq-page__empty" data-faq-empty hidden>No questions match that search. <a href="{{ contact_url }}">Ask us directly.</a></p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ page",
  "class": "section-main-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you pack it" },
    { "type": "text", "id": "text", "label": "Text", "default": "Short answers about the flask, bundles and returns." },
    { "type": "text", "id": "help_title", "label": "Help card title", "default": "Still have a question?" },
    { "type": "text", "id": "help_text", "label": "Help card text", "default": "Send a note and a real person replies within one business day." },
    { "type": "text", "id": "help_button", "label": "Help card button", "default": "Contact us" },
    { "type": "url", "id": "contact_link", "label": "Help card link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "topic", "label": "Topic", "info": "Questions in a row with the same topic are grouped under it.", "default": "The flask" },
        { "type": "text", "id": "question", "label": "Question", "default": "Can I put it in the dishwasher?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The cup lid, yes. Hand wash the body so the powder coat lasts.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ page" }]
}
{% endschema %}
