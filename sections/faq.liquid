<section class="section faq" aria-labelledby="faq-{{ section.id }}">
  <div class="page-width faq__grid">
    <h2 id="faq-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question | escape }}</span>
            {% render 'icon', icon: 'plus' %}
          </summary>
          <div class="accordion__content">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you pack it" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I put it in the dishwasher?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The lid, yes. Hand wash the body so the powder coat lasts.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Can I put it in the dishwasher?", "answer": "<p>The lid, yes. Hand wash the body so the powder coat lasts.</p>" } },
        { "type": "question", "settings": { "question": "Does it work with carbonated drinks?", "answer": "<p>Yes. The screw cap holds pressure, but open it slowly after a bumpy hike.</p>" } },
        { "type": "question", "settings": { "question": "Does the cap work as a cup?", "answer": "<p>Yes. The steel cap unscrews and holds a hot pour, so you can share without a second mug.</p>" } },
        { "type": "question", "settings": { "question": "What does the bundle discount cover?", "answer": "<p>Buy two of anything and save 10%. Buy three and save 15%. Colors and sizes can be mixed.</p>" } }
      ]
    }
  ]
}
{% endschema %}
