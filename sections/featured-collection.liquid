{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['all']
  endif
-%}
<section class="section featured" aria-labelledby="featured-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <h2 id="featured-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="section-lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="grid grid--products" role="list">
      {%- for product in collection.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product, index: forloop.index %}</li>
      {%- else -%}
        <li class="empty-note">Add products to this collection to fill the grid.</li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_link and collection.url != blank -%}
      <p class="section-foot"><a href="{{ collection.url }}" class="text-link">Shop {{ collection.title | downcase | escape }}</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your carry" },
    { "type": "text", "id": "text", "label": "Text", "default": "Same steel and lid system across the line. Choose by how long you'll be out." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_link", "label": "Show link to collection", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
