{%- comment -%}
  Brand story: a large heading, two columns of text and a short row of facts. Used on the Our story page.
{%- endcomment -%}
<section class="section story" aria-labelledby="story-{{ section.id }}">
  <div class="page-width">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1 id="story-{{ section.id }}" class="story__title">{{ section.settings.heading | escape }}</h1>
    <div class="story__cols">
      <div class="rte">{{ section.settings.text_left }}</div>
      <div class="rte">{{ section.settings.text_right }}</div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <dl class="story__facts">
        {%- for block in section.blocks -%}
          <div class="story__fact" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label | escape }}</dt>
            <dd>{{ block.settings.value | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "class": "section-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One flask, made for the cold part of the day." },
    { "type": "richtext", "id": "text_left", "label": "Left text", "default": "<p>Tamarack is named after the larch that turns gold and drops its needles every fall, the one conifer that lets go of everything before winter and comes back in spring.</p>" },
    { "type": "richtext", "id": "text_right", "label": "Right text", "default": "<p>We make one thing: a 1.2 L vacuum flask in four colors, with a steel cup lid and a handle you can grab with gloves on. No straws, no gadgets, nothing that breaks on the trail.</p>" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Capacity" },
        { "type": "text", "id": "value", "label": "Value", "default": "1.2 L" }
      ]
    }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
